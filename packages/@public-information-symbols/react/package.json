{
  "name": "@public-information-symbols/react",
  "version": "1.0.2",
  "description": "Accessible React components for all ISO 7001 public information symbols — fully typed, zero runtime dependencies beyond React",
  "keywords": [
    "accessible",
    "components",
    "icons",
    "iso",
    "iso-7001",
    "jsx",
    "public-information",
    "react",
    "react-component",
    "signs",
    "svg",
    "tsx",
    "typescript",
    "ui"
  ],
  "homepage": "https://karlnorling.github.io/public-information-symbols/",
  "bugs": {
    "url": "https://github.com/karlnorling/public-information-symbols/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Karl Norling",
    "url": "https://github.com/karlnorling"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/karlnorling/public-information-symbols",
    "directory": "packages/@public-information-symbols/react"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs',sideEffects:false})); require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module',sideEffects:false}))\"",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@public-information-symbols/core": "^1.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
