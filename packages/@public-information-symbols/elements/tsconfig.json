{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "module": "commonjs",
    "moduleResolution": "node",
    "paths": {
      "@public-information-symbols/core": ["../core/src/index.ts"],
      "@public-information-symbols/core/render": ["../core/src/render.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/__tests__/**/*", "node_modules"]
}
