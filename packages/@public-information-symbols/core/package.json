{
  "name": "@public-information-symbols/core",
  "version": "0.0.0",
  "description": "TypeScript registry and lookup helpers for ISO 7001 public information symbols — includes inline SVG, asset paths, and descriptions",
  "keywords": [
    "accessibility",
    "icons",
    "iso",
    "iso-7001",
    "pictogram",
    "public-information",
    "safety",
    "signs",
    "svg",
    "typescript"
  ],
  "homepage": "https://github.com/karlnorling/public-information-symbols",
  "bugs": {
    "url": "https://github.com/karlnorling/public-information-symbols/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/karlnorling/public-information-symbols",
    "directory": "packages/@public-information-symbols/core"
  },
  "files": [
    "dist/",
    "package.json",
    "README.md"
  ],
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.cjs.json && tsc -p tsconfig.esm.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'})); require('fs').writeFileSync('dist/esm/package.json', JSON.stringify({type:'module'}))\"",
    "test": "jest",
    "type-check": "tsc --noEmit -p tsconfig.cjs.json"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.8.3"
  }
}
